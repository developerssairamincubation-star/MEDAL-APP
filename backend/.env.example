# Database configuration
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/medal_db

# Security & JWT Auth
# REQUIRED. The app refuses to start if this is missing or shorter than 32 bytes.
# Generate one (and never commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everybody out. The signing algorithm is fixed to HS256 in code.
JWT_SECRET=
# Access-token lifetime in minutes (default 15). There are no refresh tokens yet.
ACCESS_TOKEN_EXPIRE_MINUTES=

# Pluggable Storage (cloudinary or local)
STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI SDG Classification (Multimodal OpenAI Vision or local fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email Service Configuration
# Option A: Gmail SMTP (Local development or paid Render instances with open SMTP ports)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=MEDAL Support
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Option B: HTTPS Transactional Email API (Recommended for Render Free Tier which blocks SMTP)
# Free 3,000 emails/month at https://resend.com (operates over HTTPS Port 443)
RESEND_API_KEY=re_your_api_key_here

